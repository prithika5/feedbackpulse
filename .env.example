# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=feedbackpulse

# Supabase Postgres + pgvector (Project Settings → Database → connection string)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Gemini (free key from Google AI Studio). Model is chosen before step 6 — don't hardcode it.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=

# Local embeddings (free, runs on your machine)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Frontend → backend
API_BASE_URL=http://localhost:8000

# Show the "Demo data" badge and allow mock LLM mode
DEMO_MODE=true
